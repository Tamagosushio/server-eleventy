{
  "name": "server-eleventy",
  "version": "1.0.0",
  "description": "Tamagosushi's personal website built with Eleventy.",
  "scripts": {
    "clean": "node scripts/clean.cjs",
    "build": "npm run clean && eleventy",
    "check": "node scripts/verify-build.cjs",
    "build:check": "npm run build && npm run check",
    "test": "npm run build:check",
    "start": "eleventy --serve --watch",
    "dev": "eleventy --serve --incremental"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tamagosushio/server-eleventy.git"
  },
  "keywords": [],
  "author": "Tamagosushi",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "bugs": {
    "url": "https://github.com/Tamagosushio/server-eleventy/issues"
  },
  "homepage": "https://tamagosushi.jp",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "bootstrap": "^5.3.2",
    "markdown-it": "15.0.0",
    "peggy": "^5.1.0"
  },
  "dependencies": {
    "@11ty/eleventy-img": "7.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "eleventy-plugin-code-clipboard": "^0.2.0",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-attrs": "^4.3.1"
  }
}
