<header class="main-header">
    {% set currentUrl = page.url or "/" %}
    <nav class="main-nav">
        <a class="logo" href="/" aria-label="{{ metadata.title }}へ戻る">
            <span aria-hidden="true"></span>{{ metadata.title }}
        </a>
        <ul class="nav-links">
            {% for item in navigation %}
            {% set isActive = currentUrl == item.url or (item.activePrefix and currentUrl.startsWith(item.activePrefix)) %}
            <li><a href="{{ item.url }}"{% if isActive %} class="active" aria-current="page"{% endif %}>{{ item.label }}</a></li>
            {% endfor %}
            {% if currentUrl == "/" %}
            <li class="language-switch"><button id="switch-language" type="button" aria-pressed="false" aria-label="Ŝanĝi al Esperanto" hidden>EO</button></li>
            {% endif %}
        </ul>
    </nav>
</header>
