---
layout: base.njk
---

<article class="post-article">
  <header class="post-header">
    <h1>{{ title }}</h1>
    <p><em>{{ description }}</em></p>
    <time datetime="{{ page.date | dateFormat }}">
      {{ page.date | dateFormat }}
    </time>
  </header>
  <div class="post-body">
    {{ content | safe }}
  </div>
</article>
