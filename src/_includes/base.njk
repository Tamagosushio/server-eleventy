<!DOCTYPE html>
<html lang="ja">
  <head>
    {%- set pageTitle = title or metadata.title %}
    {%- set pageDescription = description or metadata.description %}
    {%- set pageUrl = metadata.url + page.url %}
    <title>{{ pageTitle }}</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="{{ pageDescription }}" />
    <link rel="canonical" href="{{ pageUrl }}">
    <meta property="og:type" content="{{ ogType or 'website' }}">
    <meta property="og:site_name" content="{{ metadata.title }}">
    <meta property="og:url" content="{{ pageUrl }}">
    <meta property="og:title" content="{{ pageTitle }}">
    <meta property="og:description" content="{{ pageDescription }}">
    <meta name="twitter:card" content="{% if image.url %}summary_large_image{% else %}summary{% endif %}">
    <meta name="twitter:title" content="{{ pageTitle }}">
    <meta name="twitter:description" content="{{ pageDescription }}">
    {%- if image.url %}
      {%- if image.url[0] == '/' and image.url[1] != '/' %}
        {%- set socialImageUrl = metadata.url + image.url %}
      {%- else %}
        {%- set socialImageUrl = image.url %}
      {%- endif %}
    <meta property="og:image" content="{{ socialImageUrl }}">
    <meta name="twitter:image" content="{{ socialImageUrl }}">
      {%- if image.alt %}
    <meta property="og:image:alt" content="{{ image.alt }}">
    <meta name="twitter:image:alt" content="{{ image.alt }}">
      {%- endif %}
    {%- endif %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Teko:wght@700&family=Noto+Sans+JP:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/main.css">
    <link rel="stylesheet" href="/styles/vendor/prism-okaidia.css">
    <link rel="icon" href="/favicon.ico" sizes="any">
  </head>
  <body>
    <div class="page-wrapper">
        {% include "header.njk" %}

        <main class="main-content">
            {{ content | safe }}
        </main>
    </div>
    <script src="/js/code-copy.js" defer></script>
    <script>
        const switchLanguage = document.getElementById("switch-language");
        const japaneseContent = document.getElementById("ja");
        const esperantoContent = document.getElementById("eo");

        if (switchLanguage && japaneseContent && esperantoContent) {
            let isJapanese = true;
            switchLanguage.hidden = false;
            switchLanguage.addEventListener("click", () => {
                isJapanese = !isJapanese;
                japaneseContent.hidden = !isJapanese;
                esperantoContent.hidden = isJapanese;
                document.documentElement.lang = isJapanese ? "ja" : "eo";
                switchLanguage.textContent = isJapanese ? "EO" : "JA";
                switchLanguage.setAttribute("aria-pressed", String(!isJapanese));
                switchLanguage.setAttribute(
                    "aria-label",
                    isJapanese ? "Ŝanĝi al Esperanto" : "日本語に切り替える",
                );
            });
        }
    </script>
  </body>
</html>
