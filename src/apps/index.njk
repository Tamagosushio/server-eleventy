---
title: "アプリ一覧"
layout: base.njk
description: たまごすしが制作・公開しているWebアプリの一覧です。
---

<header class="apps-intro">
  <h1>アプリ一覧</h1>
  <p>{{ description }}</p>
</header>

<ul class="app-grid">
  {%- for app in collections.apps %}
  <li class="app-card">
    <a class="app-card-link" href="{{ app.url }}">
      <h2>{{ app.data.title or (app.url | replace("/apps/", "") | replace("/", "")) }}</h2>
      {% if app.data.description %}
      <p>{{ app.data.description }}</p>
      {% endif %}
    </a>
  </li>
  {%- endfor %}
</ul>
